rules_version = '2';
// Registre mondial ScanCartes : base commune à toutes les apps.
// products/{code}         : fiche du produit, écrite une seule fois par le premier joueur.
// images/{code}-{rareté}  : illustration d'un produit dans une rareté, générée par le premier
//                           joueur qui obtient cette rareté, puis figée pour tous.
service cloud.firestore {
  match /databases/{database}/documents {

    // Compte administrateur (Firebase Authentication) : seul autorisé à réinitialiser les illustrations.
    // Remplacer par l'UID du compte (console Firebase → Authentication → Utilisateurs → UID).
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['UID_ADMIN_A_REMPLACER'];
    }

    // Saison des illustrations : lue par toutes les apps, modifiée seulement par l'administrateur
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'global'
        && request.resource.data.keys().hasOnly(['epoch','resetAt'])
        && request.resource.data.epoch is int;
    }

    match /products/{code} {
      allow read: if true;
      allow create: if code.matches('^[0-9]{8,14}$')
        && request.resource.data.keys().hasOnly(['code','name','brand','category','source','createdAt'])
        && request.resource.data.code == code
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200;
      allow update, delete: if false;
    }

    match /images/{id} {
      allow read: if true;

      // Premier tirage de cette rareté : réservation, sans image
      allow create: if id.matches('^[0-9]{8,14}-(commune|peu|rare|epique|legendaire)$')
        && request.resource.data.keys().hasOnly(['code','rarity','status','createdAt','claimedAt'])
        && id == request.resource.data.code + '-' + request.resource.data.rarity
        && request.resource.data.status == 'pending';

      // Tant qu'elle est « en cours » : reprise d'une génération bloquée, ou dépôt de l'image (une seule fois)
      allow update: if resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedAt','image','status'])
        && (
          request.resource.data.status == 'pending'
          || (request.resource.data.status == 'ready'
              && request.resource.data.image is string
              && request.resource.data.image.matches('^data:image/jpeg;base64,.*')
              && request.resource.data.image.size() < 900000)
        );

      // Une illustration prête est figée ; seul l'administrateur peut tout réinitialiser
      allow delete: if isAdmin();
    }
  }
}
