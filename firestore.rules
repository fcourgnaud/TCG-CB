rules_version = '2';
// Registre mondial ScanCartes : une carte par code-barres, fixée par le premier joueur.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cards/{code} {
      allow read: if true;

      // Premier scan : création d'une carte « en cours », sans image
      allow create: if code.matches('^[0-9]{8,14}$')
        && request.resource.data.keys().hasOnly(['code','name','brand','category','source','rarity','status','createdAt','claimedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.rarity in ['commune','peu','rare','epique','legendaire']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200;

      // Tant que la carte est « en cours » : reprise d'une génération bloquée, ou dépôt de l'image (une seule fois)
      allow update: if resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedAt','image','status'])
        && (
          request.resource.data.status == 'pending'
          || (request.resource.data.status == 'ready'
              && request.resource.data.image is string
              && request.resource.data.image.matches('^data:image/jpeg;base64,.*')
              && request.resource.data.image.size() < 900000)
        );

      // Une carte prête est figée pour toujours
      allow delete: if false;
    }
  }
}
